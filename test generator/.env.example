# Test generator config template
# Copy values into .env.local for local use. Never commit real secrets.

# Google OAuth client for the separate test-generator tool
TEST_GENERATOR_GOOGLE_CLIENT_ID=
TEST_GENERATOR_GOOGLE_CLIENT_SECRET=

# Optional: if you want to pin the default target course now
TEST_GENERATOR_TARGET_COURSE_ID=

# Google scopes used by the generator tool
TEST_GENERATOR_GOOGLE_SCOPES=https://www.googleapis.com/auth/classroom.coursework.students https://www.googleapis.com/auth/classroom.courseworkmaterials https://www.googleapis.com/auth/classroom.announcements https://www.googleapis.com/auth/drive.file

# Local storage paths relative to this folder
TEST_GENERATOR_TOKEN_PATH=tokens/google-oauth.json
TEST_GENERATOR_DRAFTS_DIR=drafts
TEST_GENERATOR_RUNS_DIR=runs
TEST_GENERATOR_UPLOADS_DIR=uploads

# Safer default for first write tests
TEST_GENERATOR_DEFAULT_PUBLISH_STATE=DRAFT
