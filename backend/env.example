## Study Buddy backend env var template
## Use this as a copy/paste template for local development or Render env vars.
## NEVER commit real secrets.

# Auth/session
SESSION_SECRET=change-me-to-a-long-random-string

# OpenAI (required for /chat/send and /plan/week)
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-5.2
OPENAI_PLAN_MODEL=gpt-5-mini
OPENAI_CHAT_TIMEOUT_SECONDS=20
OPENAI_PLAN_TIMEOUT_SECONDS=30

# Persistence (SQLite)
# Local default: backend.sqlite3 (relative to backend/)
# Render recommended: /var/data/backend.sqlite3 (Persistent Disk mounted at /var/data)
SQLITE_PATH=backend.sqlite3
SQLITE_TIMEOUT_SECONDS=10
SQLITE_WAL_ENABLED=true
SQLITE_SYNCHRONOUS_NORMAL=true

# Classroom fetch reliability/performance controls
CLASSROOM_MAX_CONCURRENCY=5
CLASSROOM_CACHE_TTL_SECONDS=20

# Google OAuth / Classroom (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/auth/google/callback
OAUTH_PKCE_TTL_SECONDS=600

# WhatsApp (Meta Cloud API)
# - Create a Meta app + WhatsApp Business account, then configure a webhook to:
#   GET/POST https://<your-domain>/whatsapp/webhook
WHATSAPP_VERIFY_TOKEN=change-me
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Debug export (recommended false on Render pilot)
DEBUG_EXPORT_ENABLED=false
DEBUG_EXPORT_DIR=debug_exports
PROMPTS_HOT_RELOAD=true


