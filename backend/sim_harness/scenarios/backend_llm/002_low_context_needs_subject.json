{
  "scenario_id": "bllm-002",
  "title": "Backend LLM: low-context assignment should ask for subject and avoid invented details",
  "language": "en",
  "constraints": { "max_turns": 1 },
  "assignments": [
    { "id": "a1", "title": "Essay", "courseName": "English", "dueDate": null, "description": null, "estimatedMinutes": null }
  ],
  "initial_user_message": "Help me start.",
  "expected": {
    "require_no_selection": true,
    "assistant_text_must_contain": ["subject"],
    "assistant_text_forbidden_substrings": ["page", "pages", "chapter", "due tomorrow"],
    "max_question_marks": 2
  }
}
